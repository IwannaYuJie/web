# 环境变量配置示例
# 复制此文件为 .env 并填入真实的 API Key

# 火山引擎图片生成 API Key
ARK_API_KEY=your_ark_api_key_here

# 七牛云 AI 对话 API Key
QINIU_AI_API_KEY=your_qiniu_ai_api_key_here

# 本地开发文章管理密码（仅 Vite mock 使用）
DEV_ADMIN_KEY=replace_with_a_local_dev_password

# 邮件通知目标（Cloudflare Functions 环境变量中建议配置）
NOTIFY_EMAIL=your_notify_email@example.com
