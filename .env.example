# 环境变量配置示例
# 复制此文件为 .env 并填入真实值

# 本地开发文章管理密码（仅 Vite mock 使用）
DEV_ADMIN_KEY=replace_with_a_local_dev_password

# 本地资讯草稿使用隔离文件；文章仍沿用开发环境内存存储。
DEV_NEWS_DRAFTS_DATA_FILE=./data/dev-news-drafts.json
# 留空时可管理草稿，自动采集显示未配置。这里仅填写专用于本地测试的配置。
DEV_NEWS_WORKER_URL=
DEV_NEWS_COLLECTOR_TOKEN=

# VPS 文章 API（生产环境放在 /etc/orange-cat-blog.env，不提交真实密钥）
ADMIN_KEY=replace_with_a_strong_admin_password
ARTICLES_DATA_FILE=./data/articles.json
API_HOST=127.0.0.1
API_PORT=8361

# 生产资讯草稿配置详见 deploy/orange-cat-blog.env.example。
# NEWS_DRAFTS_DATA_FILE=/var/lib/orange-cat-blog/news-drafts.json
# NEWS_WORKER_URL=https://your-news-worker.workers.dev
# NEWS_COLLECTOR_TOKEN_FILE=/etc/orange-cat-news-collector-token
