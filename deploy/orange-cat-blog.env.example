ARTICLES_DATA_FILE=/var/lib/orange-cat-blog/articles.json
API_HOST=127.0.0.1
API_PORT=8361

# 资讯草稿文件须位于 systemd 已允许写入的 /var/lib/orange-cat-blog 目录。
NEWS_DRAFTS_DATA_FILE=/var/lib/orange-cat-blog/news-drafts.json
# 部署 Python Worker 后填写其 origin（不含 /run）；留空则后台显示未启用自动采集。
NEWS_WORKER_URL=
# 可选：独立随机 token 至少 32 字符；与 Worker secret NEWS_COLLECTOR_TOKEN 一致。
# secret 文件需 root:orange-cat、0640，供 API 的 orange-cat 用户只读。
# 配置文件实际存在后再取消注释；不要在此提交真实密钥。
# NEWS_COLLECTOR_TOKEN_FILE=/etc/orange-cat-news-collector-token
