(orange-cat-site) {
	encode zstd gzip

	handle /api/* {
		reverse_proxy 127.0.0.1:8361
	}

	handle /healthz {
		reverse_proxy 127.0.0.1:8361
	}

	handle {
		root * /opt/orange-cat-blog/current/dist
		try_files {path} /index.html
		file_server
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
	}

	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	@static path /images/* /gif.worker.js
	header @static Cache-Control "public, max-age=3600, must-revalidate"
}

(cloudflare-origin-only) {
	# Keep this list synchronized with https://www.cloudflare.com/ips/.
	# Requests that reach the origin without passing through Cloudflare are denied.
	@notCloudflare {
		not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}

	handle @notCloudflare {
		respond "Forbidden" 403
	}
}

